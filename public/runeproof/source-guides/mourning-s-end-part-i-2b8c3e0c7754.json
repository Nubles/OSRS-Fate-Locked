ha on the apple barrel."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:useSieveOnBarrel","text":["Use the sieve on the naphtha apple mix"],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:cookNaphtha","text":["Cook the toxic naphtha on a range. DO NOT USE IT ON A FIRE, and MAKE SURE TO HAVE TWO FREE INVENTORY SPACES."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:usePowderOnFood1","text":["Use the toxic powder on the food store in the room north west of West Ardougne's town centre."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:usePowderOnFood2","text":["Use the toxic powder on the food store in the church south of West Ardougne's town centre."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:talkToEssylltAfterPoison","text":["Return to Essyllt in the Mourner HQ basement."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"},{"id":"MOURNINGS_END_PART_I:field:talkToElenaNoApple","text":["Talk to Elena in north-west of East Ardougne."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"related","parentId":"MOURNINGS_END_PART_I:field:talkToElena"},{"id":"MOURNINGS_END_PART_I:field:enterMournerBasementAfterPoison","text":["Return to Essyllt in the Mourner HQ basement."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"related","parentId":"MOURNINGS_END_PART_I:field:talkToEssylltAfterPoison"},{"id":"MOURNINGS_END_PART_I:field:enterMournerBaseAfterPoison","text":["Return to Essyllt in the Mourner HQ basement."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"related","parentId":"MOURNINGS_END_PART_I:field:talkToEssylltAfterPoison"}]},{"id":"MOURNINGS_END_PART_I:node:232","title":"Report back to Arianwyn","steps":[{"id":"MOURNINGS_END_PART_I:field:returnToArianwyn","text":["Return to Arianwyn in Lletya."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"main"}]},{"id":"MOURNINGS_END_PART_I:additional","title":"Additional source instructions and alternatives","steps":[{"id":"MOURNINGS_END_PART_I:field:enterBasementAfterTorture","text":["Go down the trapdoor in the north west corner of the HQ."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"related"},{"id":"MOURNINGS_END_PART_I:field:enterMournerBaseAfterTorture","text":["Equip the full mourners outfit and enter the Mourners' Headquarters in West Ardougne."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","role":"related"}]}],"diagnostics":["Opaque object type: com.questhelper.QuestHelperConfig$MockitoMock$244I8Die"],"sources":[{"label":"Quest Helper source","path":"src/main/java/com/questhelper/helpers/quests/mourningsendparti/MourningsEndPartI.java","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a"}]}
