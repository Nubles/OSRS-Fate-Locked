","role":"main"},{"id":"MONKEY_MADNESS_II:field:talkToAwowAsKruk","text":["Talk to Awowogei as Kruk."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:field:talkToGarkorAfterKruk","text":["Talk to Garkor on Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:166","text":["Enter the shortcut near the entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"related","parentId":"MONKEY_MADNESS_II:node:163"}]},{"id":"MONKEY_MADNESS_II:node:196","title":"Defeating trolls and ogres","steps":[{"id":"MONKEY_MADNESS_II:field:enterTrollStronghold","text":["Enter the Troll Stronghold, ready to fight Kob."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:field:talkToKob","text":["Talk to Kob with Protect from Melee on, ready to fight."],"dialogue":["I know about your deal with the monkeys.","You won't be around to crush anyone when I'm done with you.","I accept your challenge."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:field:fightKob","text":["Fight Kob. He can be safespotted from the doorway."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:field:talkToKeef","text":["Talk to Keef in Gu'Tanoth. Be prepared to fight him and pray Protect from Melee."],"dialogue":["I know about your deal with the monkeys.","I offer to spare your life.","I accept your challenge."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_