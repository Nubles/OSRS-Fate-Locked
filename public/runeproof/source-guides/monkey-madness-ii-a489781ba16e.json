questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:292","text":["Go down the ladder to the north west."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:296","text":["Place a satchel on the support to the south."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:300","text":["Go to the east side and climb the ladder there."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:304","text":["Make your way to the west across the vine, then north then east. Place a satchel here."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:308","text":["Return to the east side where you came from and go up to the 2nd floor."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:312","text":["Place a satchel on the gas cylinder to the south."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:316","text":["Make your way to the west then north and place a satchel on the gas cylinder there."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:320","text":["Go back to the bottom floor."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessii/MonkeyMadnessII.java","role":"main"},{"id":"MONKEY_MADNESS_II:node:324","text":["Go back to the bottom floor."],"dialogue":[],"s