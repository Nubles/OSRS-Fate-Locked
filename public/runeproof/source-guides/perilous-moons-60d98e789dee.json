{"questId":"Perilous Moons","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"PERILOUS_MOON:node:1","title":"Ruined","steps":[{"id":"PERILOUS_MOON:field:talkToAttala","text":["Talk to Attala, stood south of Ralos' Rise."],"dialogue":["Yes."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:killSulphurNagua","text":["Kill the sulphur nagua just atop the cliff north east of Attala. You can climb the rocks just to the east to reach it quickly with 47 Agility."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:returnToAttala","text":["Return to Attala."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterCamTorum","text":["Enter the entrance to Cam Torum."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToJessamine","text":["Talk to Jessamine in the far north end of Cam Torum."],"dialogue":["Can I be of any help with the dig?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterNeypotzli","text":["Enter the Neypotzli entrance in the far north of the cavern."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToAttalaInNey","text":["Talk to Attala near the entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToZumaInNey","text":["Talk to Zuma near the entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToJessamineInNey","text":["Talk to Jessamine near the entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"}]},{"id":"PERILOUS_MOON:node:32","title":"Camping up","steps":[{"id":"PERILOUS_MOON:field:takeBuildingSupplies","text":["Take some building supplies from the crates near Jessamine."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterPrison","text":["Enter the south-west entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:buildPrisonCamp","text":["Make your way to the camp spot, marked on the minimap with a cooking range icon."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:leavePrison","text":["Return to the antechamber."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterEarthbound","text":["Enter the north-west entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:buildEarthCamp","text":["Make your way to the camp spot, marked on the minimap with a cooking range icon."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:leaveEarth","text":["Return to the antechamber."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterStreambound","text":["Enter the north-east entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:buildStreamCamp","text":["Make your way to the camp spot, marked on the minimap with a cooking range icon."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:leaveStream","text":["Return to the antechamber."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"}]},{"id":"PERILOUS_MOON:node:66","title":"Enchanting","steps":[{"id":"PERILOUS_MOON:field:talkToJessamineForTalismans","text":["Talk to Jessamine near the Monolith."],"dialogue":["What does the inscription say?","What do we do now?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:leaveNeypotzli","text":["Return to Cam Torum through the south entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToNahta","text":["Talk to Nahta in the magic shop."],"dialogue":["Actually, I've been sent by Attala."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToBlacksmith","text":["Talk to the blacksmith near the anvils."],"dialogue":["I need your help with these talismans.","Can you help?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterNeypotzliAfterBlacksmith","text":["Enter the Neypotzli entrance in the far north of Cam Torum."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:useTalismansSidebar","text":["Use the talismans to find the correct location. Earth tells you if it's east/west, and the water talisman tells you north/south.","Despite how the world map looks, the antechamber counts as being directly in the middle of the 4 areas, so if it says to go south and east when in there, you should go to the ancient shrine, accessed through the prison or the streambound cavern."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToEyatlalli","text":["Talk to Eyatlalli."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToJessamineAfterEyatlalli","text":["Talk to Jessamine near the Monolith again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:useTalismans","text":["Use the talismans to find the correct location. More details in the sidebar."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:useTalismansSidebar"}]},{"id":"PERILOUS_MOON:node:102","title":"Ritual","steps":[{"id":"PERILOUS_MOON:field:enterStreamboundAgain","text":["Enter the north-east entrance to the streambound cavern."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:getHerbloreSupplies","text":["Take herblore supplies from the supply crates in the camp. You only need the pestle and mortar."],"dialogue":["Take herblore supplies."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:collectGrub","text":["Collect a grub from the grubby sapling east of the camp."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:useGrubOnPestle","text":["Use a pestle and mortar on the moonlight grub."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:getFishingSupplies","text":["Take fishing supplies from the supply crates in the camp."],"dialogue":["Take fishing supplies."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fishBream","text":["Fish a bream from the stream east of the camp."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:useKnifeOnBream","text":["Use a knife on the raw bream."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:getHunterSupplies","text":["Take hunter supplies from the supply crates in the camp. You only need the rope, and the knife from the fishing supplies."],"dialogue":["Take hunting supplies."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterSmallEntrance","text":["Enter the entrance north of the camp."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:setTrap","text":["Set up a trap by clicking two rocks near one another."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:rustleBush","text":["Rustle the nearby bush to trap a lizard."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:pickUpMossLizard","text":["Pick up the raw moss lizard."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:useKnifeOnLizard","text":["Use a knife on the raw moss lizard."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:leaveEarthboundWithLizard","text":["Leave the area back to the antechamber via the south-east entrance."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToEyatlalliWithItems","text":["Talk to Eyatlalli with the items."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToEyatlalliAfterItems","text":["Talk to Eyatlalli."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:talkToEyatlalliWithItems"}]},{"id":"PERILOUS_MOON:node:166","title":"Blue moon","steps":[{"id":"PERILOUS_MOON:field:enterEarthboundForFight","text":["Enter the north-west entrance to the earthbound cavern when you're ready for the blue moon fight. Make food and potions from the lizards, breams, and grubby saplings before the fights."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterBlueMoonFight","text":["Enter the entrance to the blue moon fight."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fightBlueMoonSidebar","text":["Defeat the blue moon. Use a crush weapon. Protection prayers have no effect.","Remain inside of the highlighted circle on the floor to remain safe. It will move periodically.","When the highlighted circle is the full or new moon, they will use a special attack:","Weapon freeze - Your weapon is unequipped and put into ice. Attack the ice to get it back.","Brazier - two braziers will extinguish. Re-ignite them whilst avoiding the tornadoes."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterCamTorumForFights","text":["Enter the entrance to Cam Torum, ready to fight. You can make good food and potions inside Neypotzli."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:enterEarthboundForFight"},{"id":"PERILOUS_MOON:field:enterNeypotzliForFights","text":["Enter the Neypotzli entrance in the far north of Cam Torum, ready to fight."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:enterEarthboundForFight"},{"id":"PERILOUS_MOON:field:fightBlueMoon","text":["Defeat the blue moon. The sidebar has more details."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:fightBlueMoonSidebar"}]},{"id":"PERILOUS_MOON:node:187","title":"Blood moon","steps":[{"id":"PERILOUS_MOON:field:enterPrisonForFight","text":["Enter the ancient prison when you're ready for the blood moon fight. Make food and potions from the lizards, breams, and grubby saplings before the fights."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterBloodMoonFight","text":["Enter the north-east entrance to the blood moon fight."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fightBloodMoonSidebar","text":["Defeat the blood moon. Use a slash weapon. Protection prayers have no effect.","Remain inside of the highlighted circle on the floor to remain safe. It will move periodically.","When the highlighted circle is the full or new moon, they will use a special attack:","Raining blood - Blood falls from the ceiling. Avoid the blood puddles.","Blood jaguar - Jaguars appear. Attack the highlighted jaguar, avoiding the blood square. Step away from the jaguar just before each of its attacks."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fightBloodMoon","text":["Defeat the blood moon. The sidebar has more details."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:fightBloodMoonSidebar"}]},{"id":"PERILOUS_MOON:node:199","title":"Eclipse moon","steps":[{"id":"PERILOUS_MOON:field:enterStreamboundForFight","text":["Enter the streambound cavern when you're ready for the eclipse moon fight. Make food and potions from the lizards, breams, and grubby saplings before the fights."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:enterEclipseMoonFight","text":["Enter the south entrance to the eclipse moon fight."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fightEclipseMoonSidebar","text":["Defeat the eclipse moon. Use a stab weapon. Protection prayers have no effect.","Remain inside of the highlighted circle on the floor to remain safe. It will move periodically.","Only use food and potions made inside of Neypotzli.","When the highlighted circle is the full or new moon, they will use a special attack:","Eclipse shield - A moon shield appears. Keep behind the shield as it moves.","Mimic - Clones of the moon will appear. Face the clones to avoid taking damage."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:fightEclipseMoon","text":["Defeat the eclipse moon. The sidebar has more details."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related","parentId":"PERILOUS_MOON:field:fightEclipseMoonSidebar"}]},{"id":"PERILOUS_MOON:node:211","title":"Finishing off","steps":[{"id":"PERILOUS_MOON:field:talkToJessamineEnd","text":["Return to Jessamine near the Monolith again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:talkToZumaEnd","text":["Talk to Zuma."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"},{"id":"PERILOUS_MOON:field:finishQuest","text":["Talk to Eyatlalli to finish the quest."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"main"}]},{"id":"PERILOUS_MOON:additional","title":"Additional source instructions and alternatives","steps":[{"id":"PERILOUS_MOON:field:talkToAttalaAfterBlacksmith","text":["Talk to Attala near the Monolith."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","role":"related"}]}],"diagnostics":["Opaque object type: com.questhelper.QuestHelperConfig$MockitoMock$244I8Die"],"sources":[{"label":"Quest Helper source","path":"src/main/java/com/questhelper/helpers/quests/perilousmoon/PerilousMoon.java","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a"}]}
