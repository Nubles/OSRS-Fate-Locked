eofhope/ATasteOfHope.java","role":"main"},{"id":"A_TASTE_OF_HOPE:field:enterRalForEnd","text":["Climb down the trapdoor in Old Man Ral's house in south west Meiyerditch."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/atasteofhope/ATasteOfHope.java","role":"main"},{"id":"A_TASTE_OF_HOPE:field:talkToSafalaanForEnd","text":["Talk to Safalaan to complete the quest!"],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/atasteofhope/ATasteOfHope.java","role":"main"},{"id":"A_TASTE_OF_HOPE:field:talkToKael","text":["Talk to Kael outside the Theatre of Blood, prepared to fight Ranis.","He can only be hurt by the flail, and uses magic and melee attacks.","He will occasionally charge an attack and explode, dealing damage close to him. Just run away for this attack.","During the fight he will spawn vyrewatch which you'll need to kill. Whilst fighting them Ranis will be throwing blood bombs at your current location, so make sure to move around.","In his last phase he will only attack with melee, so make sure to use protect from melee!"],"dialogue":["I'm ready."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/atasteofhope/ATasteOfHope.java","role":"related","parentId":"A_TASTE_OF_HOPE:field:talkToKaelSidebar"},{"id":"A_TASTE_OF_HOPE:field:killRanis","text":["Defeat Ranis. His various mechanics are listed in the helper's sidebar."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/atasteofhope/ATasteOfHope.java","role":"related","parentId":"A_TASTE_OF_HOPE:field:killRanisSidebar"}]},{"id":"A_TASTE_OF_HOPE:additional","title":"Additional source instructions and alternatives","steps":[{"id":"A_TASTE_OF_HOPE:field:searchForVial","text":["Work out how to open the door in the room."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/atasteofhope/ATasteOfHope.java","role":"related"},{"id":"A_TASTE_OF_HOPE:node:418","text":["Search a crate in the south east corner for a vial."],"di