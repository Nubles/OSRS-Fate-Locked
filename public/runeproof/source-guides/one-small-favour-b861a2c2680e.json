{"questId":"One Small Favour","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"ONE_SMALL_FAVOUR:node:1","title":"Starting off","steps":[{"id":"ONE_SMALL_FAVOUR:field:talkToYanni","text":["Talk to Yanni Salika in Shilo Village. CKR fairy ring or take cart from Brimhaven."],"dialogue":["Is there anything else interesting to do around here?","Yes."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"}]},{"id":"ONE_SMALL_FAVOUR:node:7","title":"A few small favours","steps":[{"id":"ONE_SMALL_FAVOUR:field:talkToJungleForester","text":["Talk to a Jungle Forester south of Shilo Village."],"dialogue":["I need to talk to you about red mahogany.","Okay, I'll take your axe to get it sharpened."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToBrian","text":["Talk to Brian in the Port Sarim axe shop."],"dialogue":["Do you sharpen axes?","Look, can you sharpen this cursed axe or what?","Ok, ok, I'll do it! I'll go and see Aggie."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToAggie","text":["Talk to Aggie in Draynor Village."],"dialogue":["Could I ask you about being a character witness?","Let me guess, you're going to ask me to do you a favour?","Oh, okay, I'll see if I can find Jimmy."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToJohanhus","text":["Talk to Johanhus Ulsbrecht in the south of the H.A.M hideout."],"dialogue":["I'm looking for Jimmy the Chisel.","And I suppose you need me to do you a favour?","Ok, Jimmy has to be worth more than a few scrawny chickens!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToFred","text":["Talk to Fred the Farmer north of Lumbridge."],"dialogue":["I need to talk to you about Jimmy."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToSeth","text":["Talk to Seth Groats in the farm north east of Lumbridge, across the river."],"dialogue":["Oh, ok! I guess it's not that much further to Varrock!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToHorvik","text":["Talk to Horvik in the armour shop north east of the Varrock square."],"dialogue":["Hi, I need to talk to you about chicken cages!","Ok, I guess one good turn deserves another."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToApoth","text":["Talk to the Apothecary in west Varrock."],"dialogue":["Talk about One Small Favour.","Oh, ok, I guess it's not that far to the Barbarian Village.","I guess I can go to the Barbarian Village."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToTassie","text":["Talk to Tassie Slipcast in the Barbarian Village pottery building."],"dialogue":["Ok, I'll deal with Hammerspike!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToHammerspike","text":["Talk to Hammerspike Stoutbeard in the west cavern of the Dwarven Mine."],"dialogue":["Have you always been a gangster?","Ok, another favour...I think I can manage that."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToSanfew","text":["Talk to Sanfew upstairs in the Taverley herblore store."],"dialogue":["Are you taking any new initiates?","Do you accept dwarves?","A dwarf I know wants to become an initiate.","Yep, it's a deal."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:makeGuthixRest","text":["Make Guthix Rest by using a bowl of hot water on an empty tea cup, then using 2 guams, a marrentill and a harralander on it."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToBleemadge","text":["Right-click talk to Captain Bleemadge on White Wolf Mountain."],"dialogue":["I have a special tea here for you from Sanfew!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToArhein","text":["Talk to Arhein in Catherby."],"dialogue":["I need to talk T.R.A.S.H. to you.","Yes, Ok, I'll do it!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToPhantuwti","text":["Talk to Phantuwti in the south west house of Seers' Village."],"dialogue":["Hi, can you give me a weather forecast?","What can I do to help?","Yes, Ok, I'll do it."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:enterGoblinCave","text":["Enter the cave south east of the Fishing Guild."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:searchWall","text":["Right-click search the sculpture in the wall in the north east corner of the cave."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToCromperty","text":["Talk to Wizard Cromperty in north east Ardougne."],"dialogue":["Chat.","I need to talk to you about a girl stuck in some rock!","Oh! Ok, one more 'small favour' isn't going to kill me...I hope!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToTindel","text":["Talk to Tindel Marchant in Port Khazard."],"dialogue":["Wizard Cromperty sent me to get some iron oxide.","Ask about iron oxide.","Okay, I'll do it!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToRantz","text":["Talk to Rantz in the Feldip Hills. AKS fairy ring or Feldip Hills Teleport."],"dialogue":["I need to talk to you about a mattress.","Ok, I'll see what I can do."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:talkToGnormadium","text":["Talk to Gnormadium Avlafrim west of Rantz."],"dialogue":["Rantz said I should help you finish this project.","Yes, I'll take a look at them."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:fixAllLamps","text":["Take the gems out of each of the gnome lamps, cut them, then put back in the cut gem."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"main"},{"id":"ONE_SMALL_FAVOUR:field:goDownToJohanhus","text":["Enter the H.A.M hideout west of Lumbridge and talk to Johanhus Ulsbrecht in there."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/onesmallfavour/OneSmallFavour.java","role":"related","parentId":"ONE_SMALL_FAVOUR:field:talkToJohanhus"},{"id":"ONE_SMALL_FAVOUR:field:goDownToHammerspike","text":["Go into the Dwarven Mine and talk to Hammerspike Stoutbeard in the west si