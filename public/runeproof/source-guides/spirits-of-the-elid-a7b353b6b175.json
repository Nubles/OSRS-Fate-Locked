{"questId":"Spirits of the Elid","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"SPIRITS_OF_THE_ELID:node:1","title":"Starting Off","steps":[{"id":"SPIRITS_OF_THE_ELID:field:speakToAwusah","text":["Speak to Awusah the Mayor in Nardah."],"dialogue":["I am an adventurer in search of quests.","Any idea how you got this curse?","Yes.","Ok I will have a look around and see what I can do."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:speakToGhaslor","text":["Speak to Ghaslor the Elder, just north of Awusah."],"dialogue":["I am trying to find out the cause of this town's curse.","River spirits, what are they?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openCupboard","text":["Open and search the cupboard in the north-west corner of the house that is north of the fountain."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:useNeedleTornRobes","text":["Use the needle and thread on the torn robes (both top and bottom)."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:telegrabKey","text":["Cast the Telekinetic Grab spell on the ancestral key on the table."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:useNeedleTornRobesTop","text":["Use the needle and thread on the torn robes (both top and bottom)."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"related","parentId":"SPIRITS_OF_THE_ELID:field:useNeedleTornRobes"}]},{"id":"SPIRITS_OF_THE_ELID:node:30","title":"The Golems","steps":[{"id":"SPIRITS_OF_THE_ELID:field:enterCave","text":["Use the rope on the root to enter the cave north-west of Nardah where the river turns into a waterfall."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:useAncestralKey","text":["Equip the Robes of Elidinis and use the ancestral key on the door."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openStabDoor","text":["Open the door to the south and fight the White Golem (level-75).  You can only damage the Golem with the stab attack style."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:clearChannel","text":["Clear the Water Channel then leave the room."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openSlashDoor","text":["Open the door to the east and fight the Grey Golem (level-75).  You can only damage the Golem with the slash attack style."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:clearChannel2","text":["Clear the Water Channel then leave the room."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openCrushDoor","text":["Open the door to the north-east and fight the Black Golem (level-75).  You can only damage the Golem with the crush attack style."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:clearChannel3","text":["Clear the Water Channel by shooting the target then leave the room."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openFarNorthDoor","text":["Open the door to the north near the lake."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:speakToSpirits","text":["Talk to the Water Spirits on the north side of the lake."],"dialogue":["I come as an emissary from the people of Nardah.","Is there anything they can do to get their fountain working again?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:openStabDoorAfterGolem","text":["Open the southern door again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"related","parentId":"SPIRITS_OF_THE_ELID:field:openStabDoor"},{"id":"SPIRITS_OF_THE_ELID:field:openSlashDoorAfterGolem","text":["Open the eastern door again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"related","parentId":"SPIRITS_OF_THE_ELID:field:openSlashDoor"},{"id":"SPIRITS_OF_THE_ELID:field:openCrushDoorAfterGolem","text":["Open the north-eastern door again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"related","parentId":"SPIRITS_OF_THE_ELID:field:openCrushDoor"}]},{"id":"SPIRITS_OF_THE_ELID:node:84","title":"The Genie","steps":[{"id":"SPIRITS_OF_THE_ELID:field:speakToAwusah2","text":["Return to Nardah and speak to Awusah the Mayor."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:takeShoes","text":["Take the shoes near the doorway then leave Awusah's house."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:cutShoes","text":["Use a knife on the shoes to cut out the sole."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:enterCrevice","text":["Enter the crevice to the west of Nardah."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:talkToGenie","text":["Talk to the Genie in the Crevice."],"dialogue":["I'm after a statue that was thrown down here.","Maybe I can make a deal for it?","Ok I agree to the deal."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:talkToGenieAgain","text":["Talk to the Genie again with the sole."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:useStatuette","text":["Return to Nardah and use the statuette on the statuette plinth in the northern house."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"main"},{"id":"SPIRITS_OF_THE_ELID:field:leaveAwusah","text":["Leave Awusah's home."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/spiritsoftheelid/SpiritsOfTheElid.java","role":"related","parentId":"SPIRITS_OF_THE_ELID:field:takeShoes"}]}],"diagnostics":["Opaque object type: com.questhelper.QuestHelperConfig$MockitoMock$244I8Die"],"sources":[{"label":"Quest Helper source","path":"src/main/