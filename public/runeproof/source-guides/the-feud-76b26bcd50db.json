{"questId":"The Feud","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"THE_FEUD:node:1","title":"Starting out","steps":[{"id":"THE_FEUD:field:startQuest","text":["Talk to Ali Morrisane in Al Kharid to start the quest."],"dialogue":["Are you really the greatest salesman in the world?","I'd like to help you, but...","Yes."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:9","title":"Pollnivneach","steps":[{"id":"THE_FEUD:field:buyDisguiseGear","text":["Buy a Kharidian Headpiece and a Fake Beard to create a disguise."],"dialogue":["Okay."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:createDisguise","text":["Create a disguise by using the Kharidian Headpiece on the Fake Beard."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:goToShantay","text":["Go through Shantay Pass."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToRugMerchant","text":["Talk to the rug merchant and travel to Pollnivneach via magic carpet."],"dialogue":["Pollnivneach"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:drunkenAli","text":["Buy 3 beers from the bartender and use them on Drunken Ali to get him to explain where his son is. Talk with him between beers"],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:30","title":"Find the beef between the two factions","steps":[{"id":"THE_FEUD:field:talkToThug","text":["Talk to a Menaphite Thug to figure out how their dispute started with the bandits."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToBandit","text":["Talk to a bandit to figure out their issues with the Menaphites."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToCamelman","text":["Talk to Ali the Camel Man to try and get two camels to solve the dispute"],"dialogue":["Are those camels around the side for sale?","What price do you want for both of them?","Would 500 gold coins for the pair of them do?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToBanditReturnedCamel","text":["Tell the bandits that the Menaphites have agreed to return the camel."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToMenaphiteReturnedCamel","text":["Tell the Menaphites that the bandits have agreed to return the camel."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:49","title":"First job","steps":[{"id":"THE_FEUD:field:talkToAliTheOperator","text":["Talk to Ali the Operator to get a job from him."],"dialogue":["Yes, of course, those bandits should be taught a lesson."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:pickpocketVillager","text":["Pickpocket a villager."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:pickPocketVillagerWithUrchin","text":["Lure a villager then talk to a street urchin and get them to distract a villager, once he has them distracted pickpocket them from behind."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:getBlackjackFromAli","text":["Talk to Ali the Operator to get a blackjack."],"dialogue":["Yeah, I could do with a bit of advice."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:blackjackVillager","text":["Lure a villager to secluded place or an empty building, knock them out and then pickpocket them."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:65","title":"Second job","steps":[{"id":"THE_FEUD:field:talkToAliToGetSecondJob","text":["Talk to Ali the Operator to get the second job."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:hideBehindCactus","text":["Hide behind the cactus"],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:openTheDoor","text":["Open the door."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:goUpStairs","text":["Go up the stairs."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:crackTheSafe","text":["Search the painting to reveal the safe. Enter the code 1, 1, 2, 3, 5, 8."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:giveTheJewelsToAli","text":["Give Ali the Operator the jewels to get your final task from him."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:86","title":"Rising up","steps":[{"id":"THE_FEUD:field:talkMenaphiteToFindTraitor","text":["Talk to a Menaphite member to find the traitor."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:tellAliYouFoundTraitor","text":["Talk to Ali and tell him you have found the traitor."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToAliTheBarman","text":["Talk to Ali the Barman to find out where Traitorous Ali is."],"dialogue":["I'm looking for Traitorous Ali.","No thanks I'm ok."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToAliTheHag","text":["Talk to Ali the Hag to ask her to make some poison for you."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:giveCoinToSnakeCharmer","text":["Use coins on the snake charmer's money pot to get a snake charm and a snake basket."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:catchSnake","text":["Use the Snake Charm on a snake to capture it."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:giveSnakeToHag","text":["Give the snake to Ali the Hag."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToAliTheKebabSalesman","text":["Talk to Ali the Kebab Salesman to get a special sauce to use."],"dialogue":["Would you sell me that bottle of special kebab sauce?","No thanks, I'm good."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:getDung","text":["Use the Red Hot Sauce on the Trough and wait for a Camel to poop out the dung.\n Only pickup brown/Ugthanki dung, if you plan to do \"My Arm's Big Adventure\" or \"Forgettable Tale of a Drunken Dwarf\" then you may want to grab four more Ugthanki dung."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:givenDungToHag","text":["Talk to Ali the Hag and give her the dung."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:poisonTheDrink","text":["Use the poison on the beer glass to kill Traitorous Ali."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:tellAliOperatorPoisoned","text":["Talk to Ali the Operator and tell him he is dead."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"}]},{"id":"THE_FEUD:node:134","title":"Finishing off","steps":[{"id":"THE_FEUD:field:talkToMenaphiteLeader","text":["Talk to the Menaphite Leader and prepare for a fight against a tough guy. You can safespot him inside the tent by using a chair."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToAVillager","text":["Talk to a villager and they will be angry you broke the balance of power."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToBanditLeader","text":["Talk to the Bandit Leader and be prepared to fight a Bandit Champion. You can safe spot him with the stool."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToAVillagerToSpawnMayor","text":["Talk to a villager and they will be angry still."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:talkToMayor","text":["Talk to Ali the Mayor and get your due congratulations."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:finishQuest","text":["Talk to  Ali Morrisane in Al Kharid to finish the quest."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"main"},{"id":"THE_FEUD:field:killMenaphiteThug","text":["Kill the Menaphite Thug. You can safespot him inside the tent by using a chair, if he's not spawned then talk to the Menaphite Leader again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related","parentId":"THE_FEUD:field:talkToMenaphiteLeader"}]},{"id":"THE_FEUD:additional","title":"Additional source instructions and alternatives","steps":[{"id":"THE_FEUD:field:buyShantayPass","text":["Buy a shantay pass from Shantay."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"},{"id":"THE_FEUD:field:equipBlackjack","text":["Equip your oak blackjack in your inventory."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"},{"id":"THE_FEUD:field:goDownStairs","text":["Go down the stairs."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"},{"id":"THE_FEUD:field:pickupDung","text":["Use the bucket on the dung."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"},{"id":"THE_FEUD:field:getBucket","text":["Pick up a bucket to grab the dung"],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"},{"id":"THE_FEUD:field:killBanditChampion","text":["Kill the Bandit Champion, you can safe spot him with the stool. \n If he's not spawned then talk to the Bandit Leader again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/thefeud/TheFeud.java","role":"related"}]}],"diagnostics":["Missing panel/step reference: unclassified","Opaque o