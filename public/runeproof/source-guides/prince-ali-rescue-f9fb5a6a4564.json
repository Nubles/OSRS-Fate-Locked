{"questId":"Prince Ali Rescue","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"PRINCE_ALI_RESCUE:node:1","title":"Starting off","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToHassan","text":["Talk to Hassan in the Al Kharid Palace."],"dialogue":["Is there anything I can help you with?","Yes."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:talkToOsman","text":["Talk to Osman north of the Al Kharid Palace."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:10","title":"Make a blonde wig","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToNed","text":["Have Ned in Draynor Village make you a wig from 3 balls of wool. He can also sell you a rope for 15 coins or 4 balls of wool."],"dialogue":["Could you make other things apart from rope?","How about some sort of wig?","I have them here. Please make me a wig."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:dyeWig","text":["Dye the wig with yellow dye. Buy a yellow dye with two onions and 5 coins if you still need it from Aggie in Draynor Village."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:27","title":"Make paste","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToAggie","text":["Talk to Aggie in Draynor Village to get some paste."],"dialogue":["Can you make skin paste?","Yes please. Mix me some skin paste."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:41","title":"Make a key print","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToKeli","text":["Talk to Keli in the jail east of Draynor Village. If you've already made the key print, open the quest journal to re-sync."],"dialogue":["Heard of you? You're famous in Gielinor!","What's your latest plan then?","How do you know someone won't try to free him?","Could I see the key please?","Could I touch the key for a moment please?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:58","title":"Make the key","steps":[{"id":"PRINCE_ALI_RESCUE:field:makeKey","text":["Use the key print on any furnace with a bronze bar in your inventory to make a key."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:66","title":"Return with the items","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToLeela","text":["Talk to Leela east of Draynor Village."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:reobtainKey","text":["Talk to Leela east of Draynor Village for another key. It'll cost 15gp."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"related","parentId":"PRINCE_ALI_RESCUE:field:talkToLeela"}]},{"id":"PRINCE_ALI_RESCUE:node:78","title":"Free Ali","steps":[{"id":"PRINCE_ALI_RESCUE:field:talkToJoe","text":["Bring everything to the jail and give Joe there three beers."],"dialogue":["I have some beer here. Fancy one?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:useRopeOnKeli","text":["Use rope on Keli."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:useKeyOnDoor","text":["Use the key on the prison door. If Lady Keli respawned you'll need to tie her up again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"},{"id":"PRINCE_ALI_RESCUE:field:talkToAli","text":["Talk to Prince Ali and free him."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]},{"id":"PRINCE_ALI_RESCUE:node:94","title":"Return to Al Kharid","steps":[{"id":"PRINCE_ALI_RESCUE:field:returnToHassan","text":["Return to Hassan in the Al Kharid Palace to complete the quest."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","role":"main"}]}],"diagnostics":["Opaque object type: com.questhelper.QuestHelperConfig$MockitoMock$244I8Die","Opaque object type: net.runelite.client.config.ConfigManager"],"sources":[{"label":"Quest Helper source","path":"src/main/java/com/questhelper/helpers/quests/princealirescue/PrinceAliRescue.java","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a"}]}
