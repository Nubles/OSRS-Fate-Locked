{"questId":"Temple of Ikov","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"TEMPLE_OF_IKOV:node:1","title":"Starting off","steps":[{"id":"TEMPLE_OF_IKOV:field:talkToLucien","text":["Talk to Lucien in the pub north of East Ardougne castle."],"dialogue":["I'm a mighty hero!","That sounds like a laugh!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"}]},{"id":"TEMPLE_OF_IKOV:node:7","title":"Defeat Lesarkus","steps":[{"id":"TEMPLE_OF_IKOV:field:prepare","text":["Get your weight below 0kg. You can get boots of lightness from the Temple of Ikov north of East Ardougne for -4.5kg."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:enterDungeon","text":["Enter the Temple of Ikov north of East Ardougne."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:goDownToBoots","text":["Go down the west stairs to get boots of lightness."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:getBoots","text":["Get the boots of lightness in the north east corner."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:goUpFromBoots","text":["Go back upstairs."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:pickUpLever","text":["Cross the bridge in the north room and pick up the lever whilst weighing less than 0kg."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:useLeverOnHole","text":["Use the lever on the lever bracket in the entrance room."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:pullLever","text":["Pull the lever."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:enterArrowRoom","text":["Enter the south gate."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:collectArrows","text":["Search the chests in the ice area of this room until you have at least 20 Ice Arrows or more to be safe. If using a throwable weapon (darts, knives) a single Ice Arrow is sufficient. A random chest has the arrows each time."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:returnToMainRoom","text":["Return back to the entry room when you have enough arrows."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:goSearchThievingLever","text":["Go into the north room, then on the north side right-click search the lever there for traps, then pull it."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:tryToEnterWitchRoom","text":["Try to enter the far north door. Be prepared to fight Lesarkus, who can only be hurt by ice arrows."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:fightLes","text":["Kill the Fire Warrior of Lesarkus. He can only be hurt by the ice arrows."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:prepareBelow0","text":["Get your weight below 0kg."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:prepare"},{"id":"TEMPLE_OF_IKOV:field:enterDungeonForBoots","text":["Enter the Temple of Ikov. You can get Boots of Lightness inside to get -4.5kg."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:enterDungeon"},{"id":"TEMPLE_OF_IKOV:field:goPullThievingLever","text":["Go into the north room, then on the north side pull the lever."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:goSearchThievingLever"}]},{"id":"TEMPLE_OF_IKOV:node:70","title":"Explore deeper","steps":[{"id":"TEMPLE_OF_IKOV:field:enterLesDoor","text":["Go all the way north and talk to Winelda there."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:giveWineldaLimps","text":["Give Winelda 20 unnoted limpwurts."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:pickUpKey","text":["Follow the path around past the skeletons and lesser demons until you find a shiny key. Pick it up."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:pushWall","text":["Push the wall on the north side of this area."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:makeChoice","text":["You can now choose to either help Lucien or help the Guardians of Armadyl. To help Lucien, simply pick up the Staff of Armadyl. To help the guardians, remove the pendant of lucien and talk to one of them."],"dialogue":["I seek the Staff of Armadyl.","Lucien will give me a grand reward for it!","You're right, it's time for my yearly bath.","Ok! I'll help!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:returnToLucien","text":["Either return to Lucien west of the Grand Exchange with the Staff of Armadyl, or kill him whilst wearing the Pendant of Armadyl."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"main"},{"id":"TEMPLE_OF_IKOV:field:enterDungeonKilledLes","text":["Enter the Temple of Ikov north of East Ardougne."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:enterLesDoor"},{"id":"TEMPLE_OF_IKOV:field:enterDungeonGivenLimps","text":["Enter the Temple of Ikov north of East Ardougne. If you got the shiny key, get it and enter via Mcgrubber's wood west of Seers' Village."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:pushWall"},{"id":"TEMPLE_OF_IKOV:field:enterFromMcgrubbors","text":["Enter the house at Mcgrubbor's wood and go down the ladder."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:pushWall"},{"id":"TEMPLE_OF_IKOV:field:killLucien","text":["Equip the Armadyl Pendant and defeat Lucien in the house west of the Grand Exchange."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:returnToLucien"},{"id":"TEMPLE_OF_IKOV:field:bringStaffToLucien","text":["Bring the Staff of Armadyl to Lucien in the house west of the Grand Exchange."],"dialogue":["Yes! Here it is."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related","parentId":"TEMPLE_OF_IKOV:field:returnToLucien"}]},{"id":"TEMPLE_OF_IKOV:additional","title":"Additional source instructions and alternatives","steps":[{"id":"TEMPLE_OF_IKOV:field:talkToWinelda","text":["Talk to Winelda in the far north of the dungeon."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","role":"related"}]}],"diagnostics":["Opaque object type: com.questhelper.QuestHelperConfig$MockitoMock$244I8Die"],"sources":[{"label":"Quest Helper source","path":"src/main/java/com/questhelper/helpers/quests/templeofikov/TempleOfIkov.java","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a"}]}
