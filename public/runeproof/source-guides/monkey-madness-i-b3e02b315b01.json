{"questId":"Monkey Madness I","revision":"633ab56e2eb3eb363f21da3fd75f6f2bc0fa073a","instructionCoverage":"source-reference","permissionCoverage":"unreviewed","sections":[{"id":"MONKEY_MADNESS_I:node:1","title":"Starting off","steps":[{"id":"MONKEY_MADNESS_I:field:talkToNarnode","text":["Talk to King Narnode Shareen in the Tree Gnome Stronghold."],"dialogue":["Yes."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"}]},{"id":"MONKEY_MADNESS_I:node:8","title":"Investigate the shipyard","steps":[{"id":"MONKEY_MADNESS_I:field:flyGandius","text":["Fly with Captain Errdo to Gandius."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToCaranock","text":["Talk to G.L.O. Caranock in the shipyard."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToNarnodeAfterShipyard","text":["Return to King Narnode Shareen in the Tree Gnome Stronghold."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goUpF0ToF1","text":["Travel to the Shipyard on Karamja."],"dialogue":["I've lost my copy of the Royal Seal..."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:flyGandius"},{"id":"MONKEY_MADNESS_I:field:goUpF1ToF2","text":["Travel to the Shipyard on Karamja."],"dialogue":["Climb Up."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:flyGandius"},{"id":"MONKEY_MADNESS_I:field:goUpF2ToF3","text":["Travel to the Shipyard on Karamja."],"dialogue":["Climb Up."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:flyGandius"}]},{"id":"MONKEY_MADNESS_I:node:31","title":"Traveling to Ape Atoll","steps":[{"id":"MONKEY_MADNESS_I:field:talkToDaero","text":["Talk to Daero on the 1st floor of the Tree Gnome Stronghold. Make sure to go through all of the Chat Options until you're given a 'Leave...' option."],"dialogue":["Leave...","Who is it?","Yes","Talk about the 10th squad..."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroInHangar","text":["Talk to Daero in the hangar."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:clickPuzzle","text":["Operate the reinitialisation panel and solve the puzzle."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroAfterPuzzle","text":["Talk to Daero in the hangar again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToWaydarAfterPuzzle","text":["Talk to Waydar."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToLumdo","text":["Talk to Lumdo."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToWaydarOnCrash","text":["Talk to Waydar on Crash Island."],"dialogue":["I cannot convince Lumdo to take us to the island..."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goUpToDaero","text":["Talk to Daero on the 1st floor of the Tree Gnome Stronghold."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:talkToDaero"}]},{"id":"MONKEY_MADNESS_I:node:68","title":"Finding Garkor","steps":[{"id":"MONKEY_MADNESS_I:field:enterValley","text":["Head west and enter the valley going north WITH PROTECT FROM RANGED ON. Be wary of poison and taking damage."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:leavePrison","text":["Wait for the gorilla guard to start going away from the prison cell, then sneak out and go to the north side of the prison."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToGarkor","text":["Stick to the east edge of the town, and make your way to Garkor to the south east."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToLumdoToReturn","text":["Talk to Lumdo again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:enterValley"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroTravel","text":["Talk to Daero on the 1st floor of the Tree Gnome Stronghold."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:enterValley"}]},{"id":"MONKEY_MADNESS_I:node:85","title":"Getting amulet parts","steps":[{"id":"MONKEY_MADNESS_I:field:enterDentureBuilding","text":["Head west and enter the large open building via the south door. DO NOT STAND ON THE LIGHT FLOOR IN THE BUILDING."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:searchForDentures","text":["DO NOT WALK ON THE LIGHT FLOOR. Search the stacked crates for monkey dentures."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goDownFromDentures","text":["Search the crate in the south east corner and go down into the cavern."],"dialogue":["Yes, I'm sure."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:searchForMould","text":["Search the crate in the north west of the room for a M'amulet mould."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:leaveToPrepareForBar","text":["Teleport out to prepare for a dangerous portion. You'll want energy/stamina potions, food and prayer potions."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"}]},{"id":"MONKEY_MADNESS_I:node:136","title":"Making an Enchanted Bar","steps":[{"id":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletRun","text":["Get food, antipoison, energy / stamina / prayer potions, and return to Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:enterDungeonForAmuletRun","text":["Enter the dungeon in south Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToZooknock","text":["Talk to Zooknock in the north east of the dungeon."],"dialogue":["What do we need for the monkey amulet?","I'll be back later."],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useDentures","text":["Use the monkey dentures on Zooknock in the north east of the dungeon. If you've already done so, open the quest journal to re-sync your current state."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useMould","text":["Use the m'amulet mould on Zooknock in the north east of the dungeon. If you've already done so, open the quest journal to re-sync your current state."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useBar","text":["Use the gold bar on Zooknock in the north east of the dungeon. If you've already done so, open the quest journal to re-sync your current state."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroForAmuletRun","text":["Travel with Daero on the 1st floor of the Tree Gnome Stronghold."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletRun"},{"id":"MONKEY_MADNESS_I:field:talkToWaydarForAmuletRun","text":["Travel with Waydar."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletRun"},{"id":"MONKEY_MADNESS_I:field:talkToLumdoForAmuletRun","text":["Travel with Lumdo."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletRun"}]},{"id":"MONKEY_MADNESS_I:node:185","title":"Making an amulet","steps":[{"id":"MONKEY_MADNESS_I:field:leaveToPrepareForAmulet","text":["Teleport out to prepare to make the amulet. You'll want some food, prayer potions, antipoisons, the mould and the enchanted bar."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletMake","text":["Get food, antipoison, prayer potions, and return to Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:enterValleyForAmuletMake","text":["Head west and enter the valley going north WITH PROTECT FROM RANGED ON. Be wary of poison and taking damage."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:enterTemple","text":["Wait for the gorilla guard to start going away from the prison cell, then sneak out and go to the north side of the prison. Afterwards, head into the temple's basement."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useBarOnFlame","text":["Use the enchanted bar on the wall of flame."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroForAmuletMake","text":["Travel with Daero on the 1st floor of the Tree Gnome Stronghold."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletMake"},{"id":"MONKEY_MADNESS_I:field:talkToWaydarForAmuletMake","text":["Travel with Waydar."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletMake"},{"id":"MONKEY_MADNESS_I:field:talkToLumdoForAmuletMake","text":["Travel with Lumdo."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:goUpToDaeroForAmuletMake"},{"id":"MONKEY_MADNESS_I:field:talkToLumdoToReturn","text":["Talk to Lumdo again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:enterValleyForAmuletMake"},{"id":"MONKEY_MADNESS_I:field:talkToDaeroTravel","text":["Talk to Daero on the 1st floor of the Tree Gnome Stronghold."],"dialogue":["Yes"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"related","parentId":"MONKEY_MADNESS_I:field:enterValleyForAmuletMake"}]},{"id":"MONKEY_MADNESS_I:node:222","title":"Getting the talisman","steps":[{"id":"MONKEY_MADNESS_I:field:leaveTempleDungeon","text":["Climb the rope out. If you plan on doing Recipe for Disaster, also kill a Zombie Monkey for its bones whilst here, and a gorilla upstairs."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToMonkeyChild","text":["Go to the north west of the island and talk to the monkey child there a few times. Eventually you'll give him 5 bananas, and he'll give you a monkey talisman.","Make sure to avoid the monkey's aunt near him otherwise she'll call the guards on you."],"dialogue":["Well I'll be a monkey's uncle!","How many bananas did Aunty want?","Ok, I promise!","I've lost that toy you gave me...","Wow - can I borrow it?"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToMonkeyChild2","text":["Talk to the monkey child again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToMonkeyChild3","text":["Talk to the monkey child again."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:giveChildBananas","text":["Give the monkey child 5 bananas."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:talkToChildForTalisman","text":["Wait for the aunt to make another round, then talk to the monkey child for the talisman."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"}]},{"id":"MONKEY_MADNESS_I:node:250","title":"Bones for RFD (optional)","steps":[{"id":"MONKEY_MADNESS_I:field:talkToChildFor4Talismans","text":["This section will help you get ready for Recipe for Disaster. If you aren't interested in this, tick the box for this section in the sidebar to skip it.","Talk to the monkey child until you have 4 talismans. Tell him you lost it, and he will cry until the aunt comes back around (make sure to hide!). Talk to him again for another."],"dialogue":["I've lost that toy you gave me...","Wow - can I borrow it?","Ok, I promise!"],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:killNinja","text":["Kill a monkey archer for their bones."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:killGorilla","text":["Kill a gorilla in the temple for their bones. If they can attack you they will heal on hit, so it's recommended to safespot or flinch one."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goDownToZombie","text":["Enter into the temple's basement to kill a zombie monkey for their bones."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:killZombie","text":["Kill a zombie monkey for their bones."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"}]},{"id":"MONKEY_MADNESS_I:node:280","title":"Making a greegree","steps":[{"id":"MONKEY_MADNESS_I:field:leaveToPrepareForTalismanRun","text":["Teleport out to prepare to make the talisman. You'll want some food, prayer potions, and antipoisons.","If you want to make talismans for Recipe for Disaster, talk to the monkey child a few more times for 4 talismans, and make sure you have bones of a zombie / ninja / gorilla."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:goUpToDaeroForTalismanRun","text":["Get food, antipoison, prayer potions, and return to Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:enterDungeonForTalismanRun","text":["Enter the dungeon in south Ape Atoll."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useTalisman","text":["Use the monkey talisman on Zooknock in the north east of the dungeon. If you've already done so, open the quest journal to re-sync your current state."],"dialogue":[],"sourcePath":"src/main/java/com/questhelper/helpers/quests/monkeymadnessi/MonkeyMadnessI.java","role":"main"},{"id":"MONKEY_MADNESS_I:field:useBones","text":["Use the monkey bones on Zooknock in the north east of the dungeon. If you've already done so, open the quest journal to re-sync your current state."],"dialogue":