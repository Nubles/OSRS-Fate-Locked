{
  "name": "fate-locked-uim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://nubles.github.io/OSRS-Fate-Locked",
  "scripts": {
    "models:manifest": "node scripts/gen-model-manifest.mjs",
    "models:export": "node scripts/export-models.mjs",
    "clog:sync": "node scripts/sync-collection-log.mjs",
    "ca:sync": "node scripts/sync-combat-achievements.mjs",
    "diary:sync": "node scripts/sync-achievement-diaries.mjs",
    "diary:verify": "node scripts/sync-achievement-diaries.mjs --check",
    "content:check": "node scripts/check-content-sync.mjs",
    "chunks:sync": "node scripts/sync-chunk-content.mjs",
    "chunks:source-check": "node scripts/chunk-source.mjs --check-upstream",
    "chunks:source-verify": "vitest run scripts/chunk-source.test.ts",
    "content:sync": "node scripts/sync-collection-log.mjs && node scripts/sync-combat-achievements.mjs && node scripts/check-content-sync.mjs",
    "content:verify": "npm run diary:verify && vitest run data/contentBaseline.test.ts data/tasksConsistency.test.ts utils/taskIdMigrations.test.ts utils/caProgress.test.ts",
    "dev": "node scripts/gen-model-manifest.mjs && vite",
    "build": "node scripts/gen-model-manifest.mjs && vite build",
    "preview": "vite preview",
    "changelog:verify": "node scripts/verify-player-facing-changelog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release:verify": "npm run changelog:verify && npm test && npm run typecheck && npm run content:verify && npm run build"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.344.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.2",
    "vite": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
