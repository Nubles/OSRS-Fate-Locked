        { "kind": "level", "skill": "Attack", "level": 71 }
      ],
      "events": [
        { "eventType": "SKILL_LEVEL", "canonicalLabel": "Attack Level 71", "confidence": "EXACT", "detectorId": "skill-level-v1", "detectorVersion": 2, "evidence": { "skill": "Attack", "previousLevel": 70, "level": 71 }, "web": { "verdict": "READY" } }
      ]
    },
